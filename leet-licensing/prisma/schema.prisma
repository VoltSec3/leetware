generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LicenseStatus {
  UNUSED
  ACTIVATED
  SUSPENDED
  REVOKED
  EXPIRED
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         String         @default("ADMIN")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model License {
  id          String          @id @default(cuid())
  licenseHash String          @unique
  keyCipher   String?
  status      LicenseStatus   @default(UNUSED)
  note        String?
  alias       String?
  tier        String          @default("standard")
  userId      String?
  createdAt   DateTime        @default(now())
  expiresAt   DateTime?
  activatedAt DateTime?
  activation  Activation?
  sessions    LoaderSession[]
  auditLogs   AuditLog[]
  user        User?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id                  String          @id @default(cuid())
  username            String          @unique
  email               String?         @unique
  emailVerifiedAt     DateTime?
  discordId           String?         @unique
  passwordHash        String
  licenseId           String?         @unique
  isSuspended         Boolean         @default(false)
  suspendedUntil      DateTime?
  bannedAt            DateTime?
  banReason           String?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  lastHwidResetAt     DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  license             License?        @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  sessions            UserSession[]
  robloxAccounts      RobloxAccount[]
  emailTokens         EmailToken[]
  ipBans              IpBan[]

  @@index([username])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeen  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model IpBan {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RobloxAccount {
  id           String    @id @default(cuid())
  userId       String
  robloxUserId String    @unique
  username     String
  displayName  String?
  avatarUrl    String?
  verification String    @default("PENDING")
  addedAt      DateTime  @default(now())
  lastSeen     DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Activation {
  id            String   @id @default(cuid())
  licenseId     String   @unique
  hwidHash      String
  firstIp       String?
  lastIp        String?
  clientVersion String?
  metadata      Json?
  createdAt     DateTime @default(now())
  lastSeen      DateTime @default(now())
  license       License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([hwidHash])
  @@index([lastSeen])
}

model LoaderSession {
  id            String   @id @default(cuid())
  licenseId     String
  tokenHash     String   @unique
  robloxUserId  String?
  clientVersion String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastSeen      DateTime @default(now())
  revoked       Boolean  @default(false)
  license       License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([expiresAt])
  @@index([revoked])
}

model AuditLog {
  id        String   @id @default(cuid())
  licenseId String?
  event     String
  actorType String?
  actorName String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([event])
  @@index([createdAt])
  @@index([actorName])
}

model SupportedGame {
  id             String    @id @default(cuid())
  gameId         String    @unique
  name           String
  moduleKey      String    @unique
  delivery       String    @default("direct")
  scriptUrl      String?
  payloadSource  String?
  enabled        Boolean   @default(true)
  autoRegistered Boolean   @default(false)
  kind           String    @default("game")
  locked         Boolean   @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled])
  @@index([kind])
}

model RateLimitEntry {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
