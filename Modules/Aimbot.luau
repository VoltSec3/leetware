er, ignorePlayers) local head = Utils.GetCharacterPart(character, "Head") if not head then return true end local origin = Camera.CFrame.Position local direction = (head.Position - origin) local raycastParams = RaycastParams.new() local filter = {Player.Character} if ignorePlayers then for _, target in ipairs(Players:GetPlayers()) do if ((target ~= Player) and target.Character) then table.insert(filter, target.Character) end end end raycastParams.FilterDescendantsInstances = filter raycastParams.FilterType = Enum.RaycastFilterType.Blacklist local result = Workspace:Raycast(origin, direction, raycastParams) return ((result ~= nil) and not result.Instance:IsDescendantOf(character)) end local function IsTargetValid(target, requireFov, maintainLock, ignorePlayers) if (not target or (target == Player)) then return false end local character = target.Character local head = Utils.GetHead(target) if (not character or not head) then return false end local range = math.clamp((tonumber(Settings.Range) or 500), 1, 1500) if (((head.Position - Camera.CFrame.Position)).Magnitude > range) then return false end if IsTeamBlocked(target) then return false end if IsFriendBlocked(target) then return false end if not HasValidHealth(target, maintainLock) then return false end local screenPosition, visible = Camera:WorldToViewportPoint(head.Position) if (not maintainLock and (((screenPosition.Z <= 0) or not visible))) then return false end if (not maintainLock and requireFov) then local cursorPosition = UserInputService:GetMouseLocation() local targetPosition = Vector2.new(screenPosition.X, screenPosition.Y) if (((targetPosition - cursorPosition)).Magnitude > Settings.Fov) then return false end end if ((not maintainLock and Settings.WallCheck) and IsBlocked(character, ignorePlayers)) then return false end return true end local function GetTarget() local candidates = {} local cursorPosition = UserInputService:GetMouseLocation() local cameraPosition = Camera.CFrame.Position for _, target in ip