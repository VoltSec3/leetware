orPosition)).Magnitude local cursorRadius = GetHeadCursorRadius(head) if (((visible and cursorRadius) and (cursorDistance <= cursorRadius)) and (cursorDistance < nearestDistance)) then nearestTarget = target nearestDistance = cursorDistance end end end return nearestTarget end local function UpdateTriggerbot() if (not Settings.Triggerbot or not Aiming) then ResetTriggerbot() return end local targetPlayer = GetTriggerbotTarget() local isValidHead = ((targetPlayer and (targetPlayer ~= Player)) and IsTargetValid(targetPlayer, false, false, true)) if not isValidHead then if Settings.RepeatReaction then ResetTriggerbot() else TriggerbotNextFire = nil end return end local now = os.clock() if (TriggerbotTarget ~= targetPlayer) then TriggerbotTarget = targetPlayer TriggerbotNextFire = (now + GetTriggerbotDelay()) end if (TriggerbotNextFire and (now >= TriggerbotNextFire)) then if not ClickMouse1() then ResetTriggerbot() return end TriggerbotNextFire = nil end end local function LockMouse() if (MouseLockedByAimbot or MouseLockDisabled) then return end OriginalMouseBehavior = (AimStartMouseBehavior or UserInputService.MouseBehavior) if (IsFirstPerson() and (OriginalMouseBehavior ~= Enum.MouseBehavior.LockCenter)) then OriginalMouseBehavior = Enum.MouseBehavior.LockCenter end LockStartedInFirstPerson = IsFirstPerson() MouseLockedByAimbot = true PendingFirstPersonUnlock = false UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter end local function UpdateCircle() local settings = Settings local mousePosition = UserInputService:GetMouseLocation() FovCircle.Position = mousePosition FovCircle.Radius = settings.Fov FovCircle.Visible = settings.Enabled if settings.RainbowFov then Hue = (((Hue + settings.RainbowSpeed)) % 1) FovCircle.Color = Color3.fromHSV(Hue, 1, 1) elseif (CurrentTarget and Aiming) then FovCircle.Color = settings.TargetedFovColor else FovCircle.Color = settings.FovColor end end local function GetHumanizedAimPosition(aimPosition, now) if Settings.SnapEnabled and (SnapUntil > now) then aimPosition += SnapOffset else SnapOffset = SnapOffset:Lerp(Vector3.zero, 0.12) end if Settings.ShakeEnabled then local shake = math.clamp((tonumber(Settings.ShakeAmount) or 0), 0, 2) aimPosition += ((Camera.CFrame.RightVector * math.sin((now * 6))) + (Camera.CFrame.UpVector * math.cos((now * 5)))) * shake end return aimPosition end local inputBegan = UserInputService.InputBegan:Connect(function(input, processed) if (not Settings.Enabled or not IsInputBound(input)) then return end if (not IsFirstPerson() and (UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter)) then return end Aiming = true AimStartMouseBehavior = UserInputService.MouseBehavior if (IsFirstPerson() and (AimStartMouseBehavior ~= Enum.MouseBehavior.LockCenter)) then AimStartMouseBehavior = Enum.MouseBehavior.LockCenter end MouseLockDisabled = false end) local inputEnded = UserInputService.InputEnded:Connect(function(input) if not IsInputBound(input) then return end StopAiming() end) local renderConnection = RunService.RenderStepped:Connect(function(deltaTime) Camera = Workspace.CurrentCamera if not Camera then return end UpdateCircle() if (not Settings.Enabled or not Aiming) then StopAiming() if (PendingFirstPersonUnlock and not IsFirstPerson()) then UserInputService.MouseBehavior = Enum.MouseBehavior.Default PendingFirstPersonUnlock = false end else if not IsBindHeld() then StopAiming() return end if ((LockStartedInFirstPerson and not IsFirstPerson()) and MouseLockedByAimbot) then UnlockMouse() MouseLockDisabled = true PendingFirstPersonUnlock = false return end local target = GetLockedTarget() local now = os.clock() if target ~= SnapTarget then SnapTarget = target SnapOffset = Vector3.zero SnapUntil = 0 if target and Settings.SnapEnabled and (math.random(1, 100) <= math.clamp((tonumber(Settings.SnapChance) or 0), 0, 100)) then local randomization = math.clamp((tonumber(Settings.SnapRandomization) or 0), 0, 2) SnapOffset = Vector3.new(((math.random() * 2 - 1)